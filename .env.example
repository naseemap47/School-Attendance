# AttendFlow Configuration
# Application Port on Host
PORT=5000

# JSON Web Token Secret (Change to a strong random key in production)
JWT_SECRET=attendflow_production_jwt_secret_key_change_me

# WhatsApp Mode:
# set to 'false' to pair with a real WhatsApp account via QR scan
# set to 'true' for offline mock testing
WHATSAPP_MOCK=false
